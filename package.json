{
  "name": "md2word",
  "private": true,
  "version": "0.6.1",
  "description": "将 Markdown 按 DOCX 模板与 CSS 样式转换为 Word 文档的 Windows 桌面工具。",
  "author": "MD2Word Contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && npm run build:worker && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:4173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron dist-electron/main.js\"",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run build:desktop",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:worker": "dotnet publish worker/Md2Word.Worker/Md2Word.Worker.csproj -c Release -r win-x64 --self-contained true -o worker/publish/win-x64 -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true",
    "build:desktop": "npm run capabilities:check && npm run build:renderer && npm run build:electron && npm run build:worker",
    "capabilities:generate": "node scripts/generate-capability-docs.mjs",
    "capabilities:check": "node scripts/generate-capability-docs.mjs --check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "dotnet test worker/Md2Word.Worker.Tests/Md2Word.Worker.Tests.csproj -c Release",
    "test:protocol": "node scripts/check-worker-protocol.mjs",
    "test:all": "npm run test && npm run test:worker && npm run build:worker && npm run test:protocol",
    "test:e2e": "playwright test --config playwright.electron.config.ts",
    "test:word": "cross-env MD2WORD_RUN_WORD_E2E=1 dotnet test worker/Md2Word.Worker.Tests/Md2Word.Worker.Tests.csproj -c Release --filter FullyQualifiedName~WordEndToEndTests",
    "test:desktop": "npm run build:desktop && npm run test:protocol && npm run test:e2e",
    "test:desktop-word": "npm run build:desktop && cross-env MD2WORD_RUN_DESKTOP_WORD_E2E=1 playwright test --config playwright.electron.config.ts",
    "screenshots:desktop": "npm run build:desktop && cross-env MD2WORD_UPDATE_SCREENSHOTS=1 playwright test --config playwright.electron.config.ts e2e/electron-screenshots.spec.ts",
    "start:desktop": "electron dist-electron/main.js",
    "package:win": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.md2word.desktop",
    "productName": "MD2Word",
    "publish": null,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "worker/publish/win-x64",
        "to": "worker",
        "filter": [
          "Md2Word.Worker.exe"
        ]
      },
      {
        "from": "resources/conversion",
        "to": "conversion",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "resources/docs/MD2Word-支持能力说明.md",
        "to": "MD2Word-支持能力说明.md"
      },
      {
        "from": "resources/docs/MD2Word-模板制作指南.md",
        "to": "MD2Word-模板制作指南.md"
      },
      {
        "from": "templates/local",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icons/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD2Word",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "include": "resources/installer.nsh"
    }
  }
}
