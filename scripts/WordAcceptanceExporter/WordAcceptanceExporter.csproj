<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <OfficeInteropWordPath Condition="'$(OfficeInteropWordPath)' == ''">$(WINDIR)\assembly\GAC_MSIL\Microsoft.Office.Interop.Word\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Word.dll</OfficeInteropWordPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Office.Interop.Word" Condition="Exists('$(OfficeInteropWordPath)')">
      <HintPath>$(OfficeInteropWordPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireInstalledWordPia" BeforeTargets="ResolveReferences" Condition="!Exists('$(OfficeInteropWordPath)')">
    <Error Text="Microsoft Office Word PIA was not found. Install the Microsoft Office PIA or pass /p:OfficeInteropWordPath=&lt;path-to-Microsoft.Office.Interop.Word.dll&gt;." />
  </Target>
</Project>
