<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OfficeInteropWordPath Condition="'$(OfficeInteropWordPath)' == ''">$(WINDIR)\assembly\GAC_MSIL\Microsoft.Office.Interop.Word\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Word.dll</OfficeInteropWordPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.3.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Office.Interop.Word" Condition="Exists('$(OfficeInteropWordPath)')">
      <HintPath>$(OfficeInteropWordPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\resources\conversion\**\*">
      <Link>resources\conversion\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="RequireInstalledWordPia" BeforeTargets="ResolveReferences" Condition="!Exists('$(OfficeInteropWordPath)')">
    <Error Text="Microsoft Office Word PIA was not found. Install the Microsoft Office PIA or pass /p:OfficeInteropWordPath=&lt;path-to-Microsoft.Office.Interop.Word.dll&gt;. NuGet repackagings are intentionally unsupported." />
  </Target>
</Project>
